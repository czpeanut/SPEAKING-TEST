# Get a key at https://aistudio.google.com/apikey (free tier available).
# Used for the text-to-speech voice.
GEMINI_API_KEY=your_gemini_api_key_here

# Get a key at https://www.d-id.com (paid; trial credits on signup).
# Copy it exactly as shown on your D-ID dashboard — it already is the
# base64 string the API expects after "Basic ".
DID_API_KEY=your_d-id_api_key_here

# Optional
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck
PORT=3000
