# Get a key at https://www.simli.com (free plan: 50 min/month included)
SIMLI_API_KEY=your_simli_api_key_here

# Filled in automatically by `npm run setup:simli-face <photo>`.
# You can also paste a face id here manually.
SIMLI_FACE_ID=

# Get a key at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
GEMINI_MODEL=gemini-3.6-flash
PORT=3000
