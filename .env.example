# Get a key at https://aistudio.google.com/apikey (free tier available).
# Used for the text-to-speech voice.
GEMINI_API_KEY=your_gemini_api_key_here

# Get a key at https://www.d-id.com — an actual plan/trial needs to be
# activated on the D-ID dashboard, or the account has 0 credits and every
# generation fails with "not enough credits" even though the key itself is
# valid.
# Paste it exactly as shown on your D-ID dashboard — if it looks like
# "<id>:<secret>" (with a colon), that's fine, the server base64-encodes it
# for you. If it's already a single base64 blob with no colon, that's fine
# too.
DID_API_KEY=your_d-id_api_key_here

# Optional
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck
PORT=3000
